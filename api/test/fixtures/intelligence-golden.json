  "baselines": [
    {
      "name": "body weight outlier baseline",
      "metric": "body.weight",
      "start": "2026-02-15",
      "values": [80, 80, 80, 80, 90],
      "expected": {
        "metric": "body.weight",
        "n": 5,
        "baseline": 82,
        "latest": 90,
        "sd": 4,
        "z": 2
      }
    },
    {
      "name": "constant HRV baseline",
      "metric": "heart.hrv_sdnn",
      "start": "2026-02-15",
      "values": [60, 60, 60],
      "expected": {
        "metric": "heart.hrv_sdnn",
        "n": 3,
        "baseline": 60,
        "latest": 60,
        "sd": 0,
        "z": 0
      }
    }
  ],
  "correlations": [
    {
      "name": "perfect positive",
      "xMetric": "body.weight",
      "yMetric": "nutrition.calories",
      "start": "2026-02-20",
      "x": [1, 2, 3, 4, 5],
      "y": [2, 4, 6, 8, 10],
      "expected": {
        "a": "body.weight",
        "b": "nutrition.calories",
        "n": 5,
        "r": 1
      }
    },
    {
      "name": "known partial pearson",
      "xMetric": "body.weight",
      "yMetric": "nutrition.calories",
      "start": "2026-02-20",
      "x": [1, 2, 3, 4, 5],
      "y": [2, 4, 5, 4, 5],
      "expected": {
        "a": "body.weight",
        "b": "nutrition.calories",
        "n": 5,
        "r": 0.7746
      }
    },
    {
      "name": "constant vector returns zero",
      "xMetric": "body.weight",
      "yMetric": "nutrition.calories",
      "start": "2026-02-20",
      "x": [80, 80, 80],
      "y": [2000, 2100, 2200],
      "expected": {
        "a": "body.weight",
        "b": "nutrition.calories",
        "n": 3,
        "r": 0
      }
    }
  ],
  "readiness": {
    "name": "experiment readiness threshold",
    "metric": "body.weight",
    "start": "2026-02-01",
